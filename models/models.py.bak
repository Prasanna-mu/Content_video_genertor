from datetime import datetime
from sqlalchemy import (
    Column,
    String,
    DateTime,
    Integer,
    Text,
    ForeignKey,
    Index,
    Enum as SQLEnum,
)
from sqlalchemy.orm import relationship
from models.database import Base
import enum


class SessionStatus(str, enum.Enum):
    CREATED = "created"
    IN_PROGRESS = "in_progress"
    COMPLETED = "completed"
    FAILED = "failed"


class PPTJobStatus(str, enum.Enum):
    PENDING = "pending"
    IN_PROGRESS = "in_progress"
    COMPLETED = "completed"
    FAILED = "failed"
    SKIPPED = "skipped"


class SlideStatus(str, enum.Enum):
    PENDING = "pending"
    PARSED = "parsed"
    CONTENT_GENERATED = "content_generated"
    QUALITY_CHECKED = "quality_checked"
    TTS_COMPLETED = "tts_completed"
    FAILED = "failed"


class AudioStatus(str, enum.Enum):
    PENDING = "pending"
    GENERATED = "generated"
    FAILED = "failed"


class VideoStatus(str, enum.Enum):
    PENDING = "pending"
    RENDERING = "rendering"
    COMPLETED = "completed"
    FAILED = "failed"


class Session(Base):
    __tablename__ = "sessions"

    id = Column(String(64), primary_key=True)
    created_at = Column(DateTime, default=datetime.utcnow)
    started_at = Column(DateTime, nullable=True)
    completed_at = Column(DateTime, nullable=True)
    quality = Column(String(32), nullable=False)
    length = Column(String(32), nullable=False)
    llm_provider = Column(String(32), nullable=False)
    llm_model = Column(String(64), nullable=False)
    status = Column(SQLEnum(SessionStatus), default=SessionStatus.CREATED)
    total_ppt_count = Column(Integer, default=0)
    completed_ppt_count = Column(Integer, default=0)
    failed_ppt_count = Column(Integer, default=0)

    ppt_jobs = relationship("PPTJob", back_populates="session", cascade="all, delete-orphan")

    __table_args__ = (
        Index("ix_sessions_status", "status"),
        Index("ix_sessions_created_at", "created_at"),
    )


class PPTJob(Base):
    __tablename__ = "ppt_jobs"

    id = Column(String(64), primary_key=True)
    session_id = Column(String(64), ForeignKey("sessions.id"), nullable=False)
    ppt_filename = Column(String(256), nullable=False)
    status = Column(SQLEnum(PPTJobStatus), default=PPTJobStatus.PENDING)
    started_at = Column(DateTime, nullable=True)
    completed_at = Column(DateTime, nullable=True)
    error = Column(Text, nullable=True)

    session = relationship("Session", back_populates="ppt_jobs")
    slides = relationship("Slide", back_populates="ppt_job", cascade="all, delete-orphan")
    video_jobs = relationship("VideoJob", back_populates="ppt_job", cascade="all, delete-orphan")

    __table_args__ = (
        Index("ix_ppt_jobs_session_id", "session_id"),
        Index("ix_ppt_jobs_status", "status"),
    )


class Slide(Base):
    __tablename__ = "slides"

    id = Column(String(64), primary_key=True)
    ppt_job_id = Column(String(64), ForeignKey("ppt_jobs.id"), nullable=False)
    slide_number = Column(Integer, nullable=False)
    title = Column(String(256), nullable=True)
    raw_text = Column(Text, nullable=True)
    notes = Column(Text, nullable=True)
    status = Column(SQLEnum(SlideStatus), default=SlideStatus.PENDING)
    parsed = Column(Integer, default=0)
    content_generated = Column(Integer, default=0)
    quality_score = Column(Integer, nullable=True)
    quality_feedback = Column(Text, nullable=True)

    ppt_job = relationship("PPTJob", back_populates="slides")
    generation_attempts = relationship("GenerationAttempt", back_populates="slide", cascade="all, delete-orphan")
    audio_assets = relationship("AudioAsset", back_populates="slide", cascade="all, delete-orphan")

    __table_args__ = (
        Index("ix_slides_ppt_job_id", "ppt_job_id"),
        Index("ix_slides_status", "status"),
    )


class GenerationAttempt(Base):
    __tablename__ = "generation_attempts"

    id = Column(String(64), primary_key=True)
    slide_id = Column(String(64), ForeignKey("slides.id"), nullable=False)
    attempt_number = Column(Integer, nullable=False)
    prompt = Column(Text, nullable=True)
    response = Column(Text, nullable=True)
    quality_score = Column(Integer, nullable=True)
    created_at = Column(DateTime, default=datetime.utcnow)

    slide = relationship("Slide", back_populates="generation_attempts")

    __table_args__ = (
        Index("ix_generation_attempts_slide_id", "slide_id"),
    )


class AudioAsset(Base):
    __tablename__ = "audio_assets"

    id = Column(String(64), primary_key=True)
    slide_id = Column(String(64), ForeignKey("slides.id"), nullable=False)
    provider = Column(String(32), nullable=False)
    file_path = Column(String(512), nullable=False)
    duration = Column(Integer, nullable=True)
    format = Column(String(16), default="wav")
    status = Column(SQLEnum(AudioStatus), default=AudioStatus.PENDING)
    created_at = Column(DateTime, default=datetime.utcnow)

    slide = relationship("Slide", back_populates="audio_assets")

    __table_args__ = (
        Index("ix_audio_assets_slide_id", "slide_id"),
    )


class VideoJob(Base):
    __tablename__ = "video_jobs"

    id = Column(String(64), primary_key=True)
    ppt_job_id = Column(String(64), ForeignKey("ppt_jobs.id"), nullable=False)
    output_path = Column(String(512), nullable=True)
    duration = Column(Integer, nullable=True)
    status = Column(SQLEnum(VideoStatus), default=VideoStatus.PENDING)
    created_at = Column(DateTime, default=datetime.utcnow)
    completed_at = Column(DateTime, nullable=True)

    ppt_job = relationship("PPTJob", back_populates="video_jobs")

    __table_args__ = (
        Index("ix_video_jobs_ppt_job_id", "ppt_job_id"),
    )